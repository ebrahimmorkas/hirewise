# Copy to .env and adjust. Every value has a sensible default for local development.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite. With PostgreSQL, job search uses ranked full-text search.
# Example: postgres://hirewise:hirewise@localhost:5432/hirewise
DATABASE_URL=

# Optional. When set, Redis backs the cache and the Celery broker. When empty,
# HireWise uses an in-memory cache and runs Celery tasks synchronously.
REDIS_URL=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HireWise <no-reply@hirewise.local>
SITE_URL=http://localhost:8000
